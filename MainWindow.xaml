<Window x:Class="VrcOscSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VrcOscSender"
        Title="VRC OSC Sender"
        Width="740" Height="620"
        MinWidth="580" MinHeight="460"
        Background="#1a1a1a"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="BgPanel"   Color="#2d2d2d"/>
        <SolidColorBrush x:Key="BgCard"    Color="#383838"/>
        <SolidColorBrush x:Key="Accent"    Color="#e94560"/>
        <SolidColorBrush x:Key="AccentHov" Color="#ff6b81"/>
        <SolidColorBrush x:Key="Connected"    Color="#16a34a"/>
        <SolidColorBrush x:Key="ConnectedHov" Color="#22c55e"/>
        <SolidColorBrush x:Key="TextMain"  Color="#f5f0eb"/>
        <SolidColorBrush x:Key="TextDim"   Color="#a09080"/>
        <SolidColorBrush x:Key="InputBg"   Color="#1e1e1e"/>
        <SolidColorBrush x:Key="BorderCol" Color="#4a4a4a"/>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6 4"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"            Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground"            Value="Black"/>
            <Setter Property="BorderBrush"           Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness"       Value="1"/>
            <Setter Property="Padding"               Value="6 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Dropdown list items: black text, blue hover only -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1e3a5f"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"               Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14 7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHov}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#1e3a5f"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2a4a7f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#3d1a1a"/>
            <Setter Property="Padding"    Value="8 4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6b2020"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ParamRow" DataType="{x:Type local:OscParameter}">
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderCol}"
                    BorderThickness="1" CornerRadius="6"
                    Margin="0 3" Padding="10 8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0 0 6 0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Grid.Column="1" Margin="0 0 6 0"
                              ItemsSource="{Binding DataContext.ParamTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding Type}"/>

                    <Grid Grid.Column="2" Margin="0 0 6 0">
                        <!-- Bool: checkbox, shows True/False clearly -->
                        <CheckBox IsChecked="{Binding BoolValue}"
                                  Foreground="White"
                                  Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"
                                  VerticalAlignment="Center">
                            <CheckBox.Content>
                                <TextBlock Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="False"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BoolValue}" Value="True">
                                                    <Setter Property="Text" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </CheckBox.Content>
                        </CheckBox>
                        <!-- Int: plain textbox, white text -->
                        <TextBox Foreground="White"
                                 Text="{Binding IntValue, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsInt, Converter={StaticResource BoolToVis}}"/>
                        <!-- Float: free-type textbox, white text, any value including above 1.0 -->
                        <TextBox Foreground="White"
                                 Text="{Binding FloatText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsFloat, Converter={StaticResource BoolToVis}}"
                                 ToolTip="Type any number e.g. 1.8 for eye height"/>
                    </Grid>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="Send" Style="{StaticResource BtnGhost}"
                                Padding="10 4" Margin="0 0 4 0"
                                Command="{Binding DataContext.SendOneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="✕" Style="{StaticResource BtnDanger}"
                                Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0 0 0 14">
            <TextBlock Text="VRC OSC Sender" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Send avatar parameters to VRChat over OSC" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0 2 0 0"/>
        </StackPanel>

        <!-- Connection bar -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderCol}"
                BorderThickness="1" CornerRadius="6" Padding="12 10" Margin="0 0 0 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Host" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0 0 8 0"/>
                <TextBox   Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 12 0"/>
                <TextBlock Grid.Column="2" Text="Port" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0 0 8 0"/>
                <TextBox   Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 0"/>
                <Button Grid.Column="5" MinWidth="100"
                        Content="{Binding ConnectLabel}"
                        Command="{Binding ToggleConnectCommand}"
                        Foreground="White" BorderThickness="0"
                        Padding="14 7" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource Accent}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Connected = green -->
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Connected}"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource ConnectedHov}"/>
                                </MultiDataTrigger>
                                <!-- Disconnected hover -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnected}" Value="False"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource AccentHov}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Avatar panel -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderCol}"
                BorderThickness="1" CornerRadius="6" Padding="12 10" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 12 0">
                    <TextBlock Text="👤" FontSize="15" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <TextBlock Text="CURRENT AVATAR" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding AvatarId, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12" Foreground="#4ade80"
                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="0"
                         ToolTip="Updates when you switch avatars in VRChat"/>
                <TextBlock Grid.Column="2" Text="{Binding AvatarStatus}" Foreground="{StaticResource TextDim}"
                           FontSize="11" VerticalAlignment="Center" Margin="12 0 10 0"/>
                <Button Grid.Column="3" Content="Copy ID" Style="{StaticResource BtnGhost}"
                        Padding="10 4" Command="{Binding CopyAvatarIdCommand}"/>
            </Grid>
        </Border>

        <!-- Column headers -->
        <Grid Grid.Row="3" Margin="10 0 10 4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="98"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="OSC ADDRESS" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="TYPE"        Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="VALUE"       Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" Margin="6 0 0 0"/>
            <TextBlock Grid.Column="3" Text="ACTIONS"     Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold"/>
        </Grid>

        <!-- Parameter list -->
        <Border Grid.Row="4" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderCol}"
                BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                <ItemsControl ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource ParamRow}"/>
            </ScrollViewer>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 10 0 6">
            <Button Content="＋ Add Parameter" Style="{StaticResource BtnGhost}"
                    Command="{Binding AddParameterCommand}" Margin="0 0 8 0"/>
            <Button Content="⬆ Send All" Style="{StaticResource Btn}"
                    Command="{Binding SendAllCommand}"/>
        </StackPanel>

        <!-- Status bar — styled as button to open log -->
        <Button Grid.Row="6" Command="{Binding ShowLogCommand}"
                Cursor="Hand" ToolTip="Click to view debug log"
                BorderThickness="1" Padding="10 6">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource BorderCol}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10 6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource TextMain}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="▲ log"
                                       Foreground="{StaticResource TextDim}" FontSize="10"
                                       VerticalAlignment="Center" Margin="8 0 0 0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
